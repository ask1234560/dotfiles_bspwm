#!/bin/bash

layouts=("us" "de")

currentlayout="$(setxkbmap -query | grep layout | tr -s " " | cut -d " " -f2)"

for i in "${!layouts[@]}"
do 
    if [[ "${layouts[$i]}" == "${currentlayout}" ]]
    then
        nextindex="$(echo "($i+1) % ${#layouts[@]}" | bc)"
        nextlayout="${layouts[$nextindex]}"
        setxkbmap -layout "$nextlayout" -option caps:swapescape && { xmodmap -e "keycode 49 = grave asciitilde"; dunstify -t 10000 "Keyboard layout changed to $nextlayout" --icon="input-keyboard-symbolic"; }
        pkill -x sxhkd && sxhkd &
        break
    fi
done
