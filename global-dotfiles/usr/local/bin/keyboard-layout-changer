#!/bin/bash

layouts=("us" "de")

filename="/tmp/keyboardlayout"

if [[ -e "$filename" ]]
then
    currentlayout="$(<$filename)"
else
    currentlayout="${layouts[0]}" 
fi


for i in "${!layouts[@]}"
do 
    if [[ "${layouts[$i]}" == "${currentlayout}" ]]
    then
        nextindex="$(echo "($i+1) % ${#layouts[@]}" | bc)"
        nextlayout="${layouts[$nextindex]}"
        setxkbmap -layout "$nextlayout" -option caps:swapescape && { echo "$nextlayout" > $filename; dunstify -t 10000 "Keyboard layout changed to $nextlayout" --icon="input-keyboard-symbolic"; }
        break
    fi
done
