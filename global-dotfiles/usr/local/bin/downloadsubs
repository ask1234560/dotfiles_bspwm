#!/bin/bash
# This files uses subliminal for subtitles download

lan='en'
provider="$1"
shift

case $provider in 
    addic7ed)
        name="ADDIC7ED"
        username=$name\_username
        password=$name\_password
        ;;
    *)
        name="OPENSUBTITLES"
        username=$name\_username
        password=$name\_password
        ;;
esac

subliminal --provider.${name,,}.username $(eval "echo \${$username}") --provider.${name,,}.password $(eval "echo \${$password}") download -l $lan "$@"
