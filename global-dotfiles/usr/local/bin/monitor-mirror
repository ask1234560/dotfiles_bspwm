#!/bin/bash


# Internal display (laptop panel)
INTERNAL=$(xrandr | awk '/ connected/ && /eDP/ {print $1}')

# Find all external connected displays
EXTERNALS=$(xrandr | awk '/ connected/ && !/eDP/ {print $1}')

# If no external display found, exit
[ -z "$EXTERNALS" ] && exit 0

# Get current resolution of internal display
RESOLUTION=$(xrandr | awk -v mon="$INTERNAL" '
    $0 ~ mon && $0 ~ " connected" {found=1}
    found && /\*/ {print $1; exit}
')

dunstify "Sxhkd: Running monitor mirror (${RESOLUTION})"

# Turn off all outputs first (except internal)
for out in $EXTERNALS; do
    xrandr --output "$out" --off
done

# Mirror each external display
for out in $EXTERNALS; do
    xrandr --output "$out" --mode "$RESOLUTION" --same-as "$INTERNAL"
done

