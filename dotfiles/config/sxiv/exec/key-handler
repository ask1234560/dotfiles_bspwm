#!/bin/sh
while read file
do
        case "$1" in
        "c")
                cp "$file" ~/.cache/default_wall
                dunstify "Sxiv: set as default wall"
                ;;
        "d")
                trash "$file"
                dunstify "Sxiv: trashed"
                ;;
        "g")
                gimp "$file" &
                dunstify "Sxiv: opening in gimp"
                ;;
        "r")
                convert -rotate 90 "$file" "$file"
                dunstify "Sxiv: rotated 90 clockwise"
                ;;
        "R")
                convert -rotate -90 "$file" "$file"
                dunstify "Sxiv: rotated 90 anti-clockwise"
                ;;
        "w")
                hsetroot -fill "$file"  -tint '#9ccfe6'
                dunstify "Sxiv: wall with tint"
                ;;
        "x")
                hsetroot -fill "$file"
                dunstify "Sxiv: exact wall"
                ;;
        "y")
                xclip -selection clipboard -t image/png "$file"
                dunstify "Sxiv: copied to clipboard"
                ;;
        esac
done
